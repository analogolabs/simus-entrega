# Configuracion exclusiva para desarrollo local. Copiar como .env y no versionar.
# Usa una contrasena unica, de al menos 12 caracteres, con mayusculas, minusculas,
# numeros y simbolos. No reutilices credenciales de otros entornos.
SIMUS_LOCAL_SA_PASSWORD=__SET_LOCALLY__

# Opcionales: se conservan los valores de los scripts si se omiten.
# SIMUS_LOCAL_SQL_PORT=14344
# SIMUS_LOCAL_DB_NAME=SIMUS_LOCAL
# SIMUS_LOCAL_API_PORT=8180
# SIMUS_LOCAL_WEB_PORT=4300

# MODO PRE-ENTREGA (demo): SIMUS aún no envía correos, así que las cuentas operan sin
# confirmar su correo. Poner false para exigir la confirmación. Solo se acepta en los
# entornos Local, Development, Demo y Test. Ver docs/operacion/15-modos-de-ejecucion-y-paso-a-produccion.md
Demo__PermitirOperacionSinCorreoConfirmado=true

# Accesos iniciales seguros (activos en la entrega): webmaster@simus.test y gestor@simus.test nacen con la clave provisional «admin» y
# deben cambiarla en el primer ingreso (12 caracteres o más; «admin» no se reutiliza). Solo al crearlas. Ver docs/accesos-iniciales.md.
Database__BootstrapExigirCambioDeClave=true
SIMUS_SIEMBRA_EXIGIR_CAMBIO_DE_CLAVE=1
