# MODELO DE LA CONSULTA ABIERTA — configuración versionada (el peso NO se sube a git: se descarga al arrancar y queda en un volumen).
# La misma pareja imagen+modelo sirve en local, en un servidor con compose y en Azure Container Apps / una VM.
# Elegido tras medir cinco modelos (ver docs/desarrollo/14-sistema-de-diseno.md, «Consulta abierta»): Apache-2.0, 2,5 GB, ~3,3 GiB en memoria, mediana 2,5 s en 4 CPU.
# Alternativa con más precisión: qwen2.5:7b-instruct (Apache-2.0, 4,7 GB, ~5,5 GiB). NO usar qwen2.5:3b-instruct en producción: su licencia es de investigación.
# Cambiar de modelo = cambiar estas líneas, volver a evaluar (docs: «Consulta abierta») y desplegar de nuevo.
# Etiqueta + digest del índice multi-arquitectura (linux/amd64 y linux/arm64): el digest fija la imagen aunque la etiqueta se mueva.
SIMUS_MODELO_IMAGEN=ollama/ollama:0.40.17@sha256:ccc42bcd3d5fcf7ab0d532b300382154e1a4da56fc666bdb313b78ebdd912754
SIMUS_MODELO_NOMBRE=qwen3:4b-instruct-2507-q4_K_M
# Identificador (hash corto del manifiesto) que `ollama list` muestra para ese nombre; el script lo verifica tras descargar.
SIMUS_MODELO_ID=0edcdef34593
SIMUS_MODELO_CUANTIZACION=Q4_K_M
SIMUS_MODELO_LICENCIA="Apache-2.0"
